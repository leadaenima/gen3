+
+-- Clip subsequent ordinary scene-shader fragments to one stylised puddle.
+-- `nil` disables the mask.  Kept in Voxel3D rather than a bespoke shader so
+-- reflected sprites keep the exact live texture/palette path as characters.
+function Voxel3D.puddleMask(puddle, wetness)
+  if not (active and activeShader) then return end
+  if puddle then
+    pcall(activeShader.send, activeShader, "puddleMask",
+          { puddle.wx or 0, puddle.wz or 0, puddle.rx or 0, puddle.rz or 0 })
+    pcall(activeShader.send, activeShader, "puddleMaskState",
+          { puddle.seed or 0, wetness or 1 })
+  else
+    pcall(activeShader.send, activeShader, "puddleMask", { 0, 0, 0, 0 })
+    pcall(activeShader.send, activeShader, "puddleMaskState", { 0, 0 })
+  end
