 local function skyFor(map)
   local sky = VoxelScene.skyColor(map, skyStrength(Voxel.angle))
   if not sky then return nil end
-  return Sky.dress(sky)
+  sky = Sky.dress(sky)
+
+  -- Weather W2: a sealed cloud deck also changes the light reaching the sky
+  -- beneath it.  Blend the generated blue bands toward a cool grey for
+  -- Overcast/Rain/Thunderstorm so tiny feather gaps never read as clear sky.
+  -- The visible cloud cover is still world-space geometry; this is the colour
+  -- of the atmosphere behind it, analogous to the diffuse light under a real
+  -- continuous ceiling.
+  local ws = CinematicAtmos.skyWeather and CinematicAtmos.skyWeather() or nil
+  if ws and ws.color and ws.blend and ws.blend > 0 then
+    local t = math.max(0, math.min(1, ws.blend))
+    local c = ws.color
+    local function blend3(v)
+      return {
+        v[1] * (1 - t) + c[1] * t,
+        v[2] * (1 - t) + c[2] * t,
+        v[3] * (1 - t) + c[3] * t,
+      }
+    end
+    local fill = blend3(sky)
+    sky[1], sky[2], sky[3] = fill[1], fill[2], fill[3]
+    if sky.bands then
+      local bands = {}
+      for i = 1, #sky.bands do bands[i] = blend3(sky.bands[i]) end
+      sky.bands = bands
+    end
+  end
+
+  -- Thunderstorm lightning is atmospheric illumination, not a 2D white card.
+  -- Brighten the generated sky bands toward a cold electric blue-white during
+  -- each irregular flash; the voxel world receives the matching light pulse
+  -- below through CinematicAtmos.worldTint().
+  if ws and ws.flash and ws.flash > 0.001 then
+    local t = math.max(0, math.min(0.82, ws.flash * 0.72))
+    local c = { 0.84, 0.91, 1.00 }
+    local function flash3(v)
+      return {
+        v[1] * (1 - t) + c[1] * t,
+        v[2] * (1 - t) + c[2] * t,
+        v[3] * (1 - t) + c[3] * t,
+      }
+    end
+    local fill = flash3(sky)
+    sky[1], sky[2], sky[3] = fill[1], fill[2], fill[3]
+    if sky.bands then
+      local bands = {}
+      for i = 1, #sky.bands do bands[i] = flash3(sky.bands[i]) end
+      sky.bands = bands
+    end
+  end
+  return sky
 end
 
