 local MOON_CRATERS = Sky.MOON_CRATERS
 
+-- ------- HD celestial bodies
+--
+-- W6 retires the canvas-grid sun/moon as the normal visible asset. The sky
+-- still uses DayNight's physically coherent bearing/elevation solution, but
+-- the body itself is now a smooth, high-resolution procedural texture. The
+-- SUN is shaded as an emissive sphere (limb response + restrained granulation),
+-- while the MOON is an original 256px cratered sprite generated once at runtime.
+-- A separate soft halo texture provides atmospheric scattering; the existing
+-- world-space god rays remain the true volumetric component and share the same
+-- DayNight/ShadowMap light direction.
+local celestialTex = { sun=nil, moon=nil, sunGlow=nil, moonGlow=nil }
+
+local function smooth01(x)
+  x = math.max(0, math.min(1, x))
+  return x * x * (3 - 2 * x)
+end
+
+local function hash01(n)
+  local x = math.sin(n * 12.9898 + 78.233) * 43758.5453
+  return x - math.floor(x)
+end
+
+local MOON_HD_CRATERS = {}
+for i = 1, 22 do
+  MOON_HD_CRATERS[i] = {
+    (hash01(i * 7 + 1) * 2 - 1) * 0.72,
+    (hash01(i * 7 + 2) * 2 - 1) * 0.72,
+    0.035 + hash01(i * 7 + 3) * 0.115,
+  }
+end
+
+local function moonCraterField(nx, ny)
+  local shade = 0
+  for i = 1, #MOON_HD_CRATERS do
+    local cr = MOON_HD_CRATERS[i]
+    local cx, cy, rr = cr[1], cr[2], cr[3]
+    local dx, dy = nx - cx, ny - cy
+    local d = math.sqrt(dx * dx + dy * dy) / rr
+    if d < 1.0 then
+      local bowl = 1.0 - d
+      shade = shade - bowl * (0.085 + rr * 0.46)
+      local rim = math.max(0, 1.0 - math.abs(d - 0.82) / 0.16)
+      local facing = math.max(0, (-dx - dy) / math.max(rr * 1.4, 1e-5))
+      shade = shade + rim * facing * 0.052
+    end
+  end
+  return shade
+end
+
+local function buildCelestialTexture(moon)
+  if not (love and love.image and love.image.newImageData
+          and love.graphics and love.graphics.newImage) then return nil end
+  local N = 256
+  local ok, tex = pcall(function()
+    local img = love.image.newImageData(N, N)
+    for y = 0, N - 1 do
+      local ny = ((y + 0.5) / N) * 2 - 1
+      for x = 0, N - 1 do
+        local nx = ((x + 0.5) / N) * 2 - 1
+        local r2 = nx * nx + ny * ny
+        if r2 <= 1.0 then
+          local z = math.sqrt(math.max(0, 1.0 - r2))
+          local edge = smooth01(math.min(1, (1.0 - math.sqrt(r2)) * 18.0))
+          if moon then
+            local n = math.sin(nx * 37.0 + ny * 19.0) * 0.018
+                    + math.sin(nx * 73.0 - ny * 41.0 + 1.7) * 0.010
+            local directional = 0.76 + 0.22 * z - 0.055 * nx - 0.035 * ny
+            local function mare(cx, cy, rr, depth)
+              local dx, dy = nx - cx, ny - cy
+              local d = math.sqrt(dx * dx + dy * dy) / rr
+              if d >= 1 then return 0 end
+              local q = 1 - d
+              q = q * q * (3 - 2 * q)
+              return -depth * q
+            end
+            local maria = mare(-0.28, -0.02, 0.34, 0.105)
+                        + mare( 0.24, -0.19, 0.25, 0.080)
+                        + mare( 0.10,  0.33, 0.21, 0.060)
+                        + mare(-0.02, -0.43, 0.17, 0.048)
+            local c = math.max(0.38, math.min(1.0, directional + n + maria
+                              + moonCraterField(nx, ny)))
+            img:setPixel(x, y, c * 0.94, c * 0.975, math.min(1, c * 1.05), edge)
+          else
+            local gran = math.sin(nx * 42.0 + math.sin(ny * 17.0) * 2.1)
+                       * math.sin(ny * 35.0 - nx * 8.0) * 0.025
+            local limb = 0.72 + 0.28 * (z ^ 0.42)
+            local hot = math.max(0, math.min(1, limb + gran))
+            img:setPixel(x, y, 1.0, 0.73 + hot * 0.25, 0.34 + hot * 0.47, edge)
+          end
+        else
+          img:setPixel(x, y, 0, 0, 0, 0)
+        end
+      end
+    end
+    local out = love.graphics.newImage(img)
+    out:setFilter("linear", "linear")
+    return out
+  end)
+  return (ok and tex) or nil
+end
+
+local function buildGlowTexture()
+  if not (love and love.image and love.image.newImageData
+          and love.graphics and love.graphics.newImage) then return nil end
+  local N = 256
+  local ok, tex = pcall(function()
+    local img = love.image.newImageData(N, N)
+    for y = 0, N - 1 do
+      local ny = ((y + 0.5) / N) * 2 - 1
+      for x = 0, N - 1 do
+        local nx = ((x + 0.5) / N) * 2 - 1
+        local r = math.sqrt(nx * nx + ny * ny)
+        local a = r < 1 and ((1 - r) ^ 2.6) or 0
+        img:setPixel(x, y, 1, 1, 1, a)
+      end
+    end
+    local out = love.graphics.newImage(img)
+    out:setFilter("linear", "linear")
+    return out
+  end)
+  return (ok and tex) or nil
+end
+
+local function celestialImage(moon)
+  local key = moon and "moon" or "sun"
+  if celestialTex[key] == false then return nil end
+  if not celestialTex[key] then celestialTex[key] = buildCelestialTexture(moon) or false end
+  return celestialTex[key] or nil
+end
+
+local function celestialGlow(moon)
+  local key = moon and "moonGlow" or "sunGlow"
+  if celestialTex[key] == false then return nil end
+  if not celestialTex[key] then celestialTex[key] = buildGlowTexture() or false end
+  return celestialTex[key] or nil
+end
+
